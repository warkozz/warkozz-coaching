---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/layout/PageHero.astro';
import Icon from '../components/ui/Icon.astro';
import CtaBanner from '../components/sections/CtaBanner.astro';
import { gallery } from '../content/gallery';
---

<BaseLayout title="Galerie" description="Extraits de sessions, screens de gameplay et reviews de VOD.">
  <PageHero eyebrow="Médias" title="Galerie" lead="Extraits de sessions, screens de gameplay et reviews de VOD." />

  <section class="section container">
    <div class="masonry">
      {
        gallery.map((item) => (
          <button type="button" class="item" data-label={item.label} data-src={item.src} style={`height:${item.height}px`}>
            {item.src ? <img src={item.src} alt={item.label} loading="lazy" /> : <span>{item.label}</span>}
          </button>
        ))
      }
    </div>
  </section>

  <dialog id="lightbox" aria-label="Aperçu">
    <button type="button" class="lb-close" id="lb-close" aria-label="Fermer"><Icon name="close" size={22} /></button>
    <div id="lb-content"></div>
  </dialog>

  <CtaBanner title="Envie du même suivi pour ton propre gameplay ?" label="Voir les formations" href="/formations" />
</BaseLayout>

<script>
  const dialog = document.getElementById('lightbox') as HTMLDialogElement;
  const content = document.getElementById('lb-content')!;
  document.querySelectorAll<HTMLButtonElement>('.item').forEach((item) =>
    item.addEventListener('click', () => {
      if (item.dataset.src) {
        const img = document.createElement('img');
        img.src = item.dataset.src;
        img.alt = item.dataset.label ?? '';
        content.replaceChildren(img);
      } else {
        const ph = document.createElement('div');
        ph.className = 'lb-ph';
        ph.textContent = item.dataset.label ?? '';
        content.replaceChildren(ph);
      }
      dialog.showModal();
    }),
  );
  document.getElementById('lb-close')!.addEventListener('click', () => dialog.close());
  dialog.addEventListener('click', (e) => e.target === dialog && dialog.close());
</script>

<style>
  .masonry {
    columns: 3 320px;
    column-gap: 16px;
  }
  .item {
    display: flex;
    align-items: flex-end;
    width: 100%;
    margin-bottom: 16px;
    padding: 16px;
    overflow: hidden;
    break-inside: avoid;
    border: 1px solid var(--border);
    border-radius: 18px;
    background: linear-gradient(135deg, #171b28, #10131c);
    color: var(--text-faint);
    font: 14px var(--font-body);
    text-align: left;
    cursor: zoom-in;
    transition: transform 0.2s, border-color 0.2s;
  }
  .item:hover {
    transform: translateY(-3px);
    border-color: rgba(0, 217, 232, 0.4);
  }
  .item img {
    width: 100%;
    height: 100%;
    margin: -16px;
    object-fit: cover;
  }
  dialog {
    width: min(92vw, 1000px);
    padding: 0;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-lg);
    background: var(--bg-raised);
    color: var(--text);
    overflow: hidden;
  }
  dialog::backdrop {
    background: rgba(5, 6, 10, 0.85);
    backdrop-filter: blur(6px);
  }
  .lb-close {
    position: absolute;
    top: 14px;
    right: 14px;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--border-strong);
    border-radius: 12px;
    background: rgba(10, 11, 16, 0.7);
    color: var(--text);
    cursor: pointer;
  }
  dialog :global(.lb-ph) {
    display: grid;
    place-items: center;
    min-height: 60vh;
    color: var(--text-dim);
    font-size: 20px;
  }
  dialog :global(img) {
    width: 100%;
    max-height: 85vh;
    object-fit: contain;
  }
</style>
