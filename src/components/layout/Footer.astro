---
import { site, footerColumns, socials } from '../../content/site';
import Logo from './Logo.astro';
---

<footer class="footer">
  <div class="container footer__inner">
    <div class="footer__grid">
      <div class="footer__brand">
        <Logo />
        <p>{site.tagline}</p>
      </div>
      {
        footerColumns.map((col) => (
          <div>
            <h4>{col.title}</h4>
            <ul>
              {col.links.map((l) => (
                <li>
                  <a href={l.href}>{l.label}</a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
      <div>
        <h4>Suivez-nous</h4>
        <ul>
          {
            socials.map((s) => (
              <li>
                <a href={s.href} target="_blank" rel="noopener noreferrer">
                  {s.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
    <div class="footer__bottom">
      <span>© {new Date().getFullYear()} {site.name}</span>
      <span>Tous droits réservés</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--bg-raised);
    border-top: 1px solid rgba(255, 255, 255, 0.07);
    padding-top: 64px;
  }
  .footer__grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1fr;
    gap: 48px;
  }
  .footer__brand {
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: 320px;
    color: var(--text-dim);
  }
  h4 {
    font-size: 16px;
    margin-bottom: 14px;
  }
  .footer ul {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .footer li a {
    color: var(--text-dim);
    transition: color 0.15s;
  }
  .footer li a:hover {
    color: var(--cyan);
  }
  .footer__bottom {
    display: flex;
    justify-content: space-between;
    margin-top: 48px;
    padding-block: 24px;
    border-top: 1px solid rgba(255, 255, 255, 0.07);
    font-size: 14px;
    color: var(--text-dim);
  }
  @media (max-width: 820px) {
    .footer__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 32px;
    }
    .footer__brand {
      grid-column: 1 / -1;
    }
    .footer__bottom {
      flex-direction: column;
      gap: 6px;
    }
  }
</style>
