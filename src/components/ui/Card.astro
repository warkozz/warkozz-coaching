---
interface Props {
  tone?: 'default' | 'cyan' | 'orange';
  class?: string;
}

const { tone = 'default', class: className = '' } = Astro.props;
---

<div class:list={['card', `card--${tone}`, className]}>
  <slot />
</div>

<style>
  .card {
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.06), rgba(255, 255, 255, 0.02));
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 32px;
  }
  .card--cyan {
    border-color: rgba(0, 217, 232, 0.35);
    background:
      radial-gradient(420px 260px at 0% 0%, rgba(0, 217, 232, 0.16), transparent 70%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.06), rgba(255, 255, 255, 0.02));
  }
  .card--orange {
    border-color: rgba(255, 122, 26, 0.3);
    background:
      radial-gradient(420px 260px at 100% 0%, rgba(255, 122, 26, 0.22), transparent 70%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.06), rgba(255, 255, 255, 0.02));
  }
</style>
