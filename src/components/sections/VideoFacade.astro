---
import Icon from '../ui/Icon.astro';

interface Props {
  youtubeId: string;
  title: string;
}

const { youtubeId, title } = Astro.props;
---

<div class="video" data-youtube={youtubeId} data-title={title}>
  <button type="button" class="video__play" aria-label={`Lire : ${title}`}>
    <Icon name="play" size={30} />
  </button>
  <span class="video__caption">{title}</span>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.video[data-youtube]').forEach((el) => {
    el.querySelector('button')?.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${el.dataset.youtube}?autoplay=1`;
      iframe.title = el.dataset.title ?? 'Vidéo';
      iframe.allow = 'autoplay; encrypted-media; picture-in-picture';
      iframe.allowFullscreen = true;
      el.replaceChildren(iframe);
    });
  });
</script>

<style>
  .video {
    position: relative;
    height: 340px;
    overflow: hidden;
    border: 1px solid rgba(0, 217, 232, 0.3);
    border-radius: var(--radius-lg);
    background:
      radial-gradient(400px 260px at 50% 50%, rgba(0, 217, 232, 0.22), transparent 70%),
      linear-gradient(135deg, #171b28, #0e1119);
    box-shadow: 0 0 80px rgba(0, 217, 232, 0.12);
  }
  .video :global(iframe) {
    width: 100%;
    height: 100%;
    border: 0;
  }
  .video__play {
    position: absolute;
    inset: 50% auto auto 50%;
    display: grid;
    place-items: center;
    width: 88px;
    height: 88px;
    margin: -44px 0 0 -44px;
    border: 0;
    border-radius: 50%;
    background: var(--cyan);
    color: var(--cyan-ink);
    box-shadow: 0 0 48px rgba(0, 217, 232, 0.55);
    cursor: pointer;
    transition: transform 0.2s;
  }
  .video__play:hover {
    transform: scale(1.08);
  }
  .video__caption {
    position: absolute;
    left: 20px;
    bottom: 20px;
    padding: 8px 14px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--border-strong);
    background: rgba(10, 11, 16, 0.7);
    font-size: 13px;
    color: var(--text-dim);
  }
</style>
